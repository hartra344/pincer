---
import Icon from '../components/Icon.astro';
import DeviceShot from '../components/landing/DeviceShot.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import '../styles/tokens.css';
import '../components/landing/landing.css';
import logo from '../assets/logo.svg';
import heroMac from '../assets/screenshots/features/homepage.png';
import heroPhone from '../assets/screenshots/ios/transcript.png';
import captureMac from '../assets/screenshots/quick-capture.png';
import approvalsMac from '../assets/screenshots/exec-approval.png';
import approvalsPhone from '../assets/screenshots/ios/exec-approval.png';
import paletteMac from '../assets/screenshots/command-palette.png';
import channelsPhone from '../assets/screenshots/ios/organize-chats.png';
import offlineMac from '../assets/screenshots/features/offline-outbox.png';
import offlinePhone from '../assets/screenshots/features/ios/offline-outbox.png';
import transcriptMac from '../assets/screenshots/transcript.png';
import transcriptPhone from '../assets/screenshots/ios/tool-details.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const repo = 'https://github.com/hartra344/pincer';
const openclaw = 'https://github.com/openclaw/openclaw';

const lines = [
	{
		id: 'system',
		label: 'System',
		title: 'Part of your Mac and iPhone.',
		body: 'Pincer isn’t a tab you have to find. It answers a global shortcut, shows up in the share sheet and Shortcuts, and follows you between devices.',
		specifics: [
			['Quick Capture', 'opens a small composer over any app with ⌃⇧Space. Send to any chat without switching windows. macOS.'],
			['The share sheet', 'sends a page, photo or file from any app to an agent.'],
			['Shortcuts, Siri and Spotlight', 'can ask an agent, send to a chat or count pending approvals, mostly without opening the app.'],
			['Handoff and links', 'move the chat you’re reading between Mac and iPhone. Every chat and message has a pincer:// link.'],
			['The menu bar', 'shows what’s unread, running and waiting for you. macOS.'],
		],
		links: [
			['Quick Capture', 'guides/quick-capture/'],
			['Share to Pincer', 'guides/sharing-to-pincer/'],
			['Shortcuts & Siri', 'guides/shortcuts-and-siri/'],
			['Deep links & Handoff', 'guides/deep-links-and-handoff/'],
		],
		mac: captureMac,
		macAlt: 'Pincer on macOS, demo capture: the Quick Capture panel with a message ready to send.',
		cols: 'minmax(0, 5fr) minmax(0, 7fr)',
	},
	{
		id: 'approvals',
		label: 'Approvals',
		title: 'Approvals in a notification.',
		body: 'Allow once, always allow or deny an exec request from a banner or a notification, without opening the chat. On iPhone they arrive even while Pincer is closed, through background refresh or a push relay you host.',
		links: [
			['Approvals and notifications', 'guides/approvals-and-notifications/'],
			['Notifications while closed (iOS)', 'guides/push-notifications/'],
		],
		mac: approvalsMac,
		phone: approvalsPhone,
		macAlt: 'Pincer on macOS, demo capture: an exec approval request with allow once, always allow and deny.',
		phoneAlt: 'Pincer on iPhone, demo capture: the same exec approval request.',
		flip: true,
		cols: 'minmax(0, 4fr) minmax(0, 8fr)',
		pad: 'var(--space-9)',
	},
	{
		id: 'gateways',
		label: 'Gateways',
		title: 'Every gateway in one window.',
		body: 'Sign in to home, work and a test box at once. Press ⌘K to jump to any chat on any of them, and open chats in their own windows on the Mac, or side by side on Mac and iPad.',
		links: [
			['Manage gateways', 'guides/manage-gateways/'],
			['Command palette and navigation', 'guides/command-palette-and-navigation/'],
			['Chat windows', 'guides/chat-windows/'],
		],
		mac: paletteMac,
		phone: channelsPhone,
		macAlt: 'Pincer on macOS, demo capture: the ⌘K palette finding a chat as you type.',
		phoneAlt: 'Pincer on iPhone, demo capture: the chat list grouped by agent and channel.',
		cols: 'minmax(0, 6fr) minmax(0, 6fr)',
		pad: 'var(--space-8)',
	},
	{
		id: 'offline',
		label: 'Offline',
		title: 'Instant, even offline.',
		body: 'Every chat is kept on your device, so switching chats and scrolling up never wait on the network. Read and search while offline, and anything you write waits in an outbox until you reconnect.',
		specifics: [
			['Native lists', 'and text rendering, with time budgets for switching chats, scrolling and streaming that every change is tested against.'],
		],
		links: [
			['Local cache', 'guides/local-cache/'],
			['Offline sending & retry', 'guides/offline-outbox/'],
			['Search', 'guides/search/'],
		],
		mac: offlineMac,
		phone: offlinePhone,
		macAlt: 'Pincer on macOS, demo capture: a chat with a failed message and Retry and Delete controls.',
		phoneAlt: 'Pincer on iPhone, demo capture: the same failed message.',
		flip: true,
		cols: 'minmax(0, 5fr) minmax(0, 7fr)',
	},
	{
		id: 'chat',
		label: 'Chat',
		title: 'And everything else you’d expect.',
		body: 'Live thinking, tool calls, subagent runs, slash commands, read aloud and dictation, themes, and the common Gateway Settings pages, all as native views. For the full config editor and other admin tools, the Control UI is still the place.',
		links: [
			['The transcript', 'guides/transcript/'],
			['Gateway Settings', 'guides/gateway-settings/'],
			['Pincer vs the Control UI', 'getting-started/why-pincer/'],
		],
		mac: transcriptMac,
		phone: transcriptPhone,
		macAlt: 'Pincer on macOS, demo capture: a transcript with a thinking section and tool-call cards.',
		phoneAlt: 'Pincer on iPhone, demo capture: the details of a tool call.',
		cols: 'minmax(0, 5fr) minmax(0, 7fr)',
	},
];

const facts = [
	['Per-device identity', 'An Ed25519 key in the Keychain, this device only. The gateway approves it once.'],
	['Encrypted transport', '<code>wss://</code> required off your LAN or tailnet, with optional TLS certificate pinning.'],
	['Scoped access', 'Read, write and approvals by default. Admin only when you ask for it.'],
	['Sandboxed', 'The macOS app is sandboxed and caches transcripts with complete file protection.'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Pincer: OpenClaw as a native Mac and iPhone app</title>
		<meta
			name="description"
			content="Pincer is a native macOS and iOS app for your OpenClaw Gateway: Quick Capture, the share sheet, Shortcuts, approvals from notifications, offline reading and every gateway in one window."
		/>
		<meta name="theme-color" content="#17211e" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#e6ece8" media="(prefers-color-scheme: light)" />
		<link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
		<meta property="og:title" content="Pincer for OpenClaw" />
		<meta
			property="og:description"
			content="Your OpenClaw agents as a native Mac and iPhone app, not a browser tab."
		/>
		<meta property="og:type" content="website" />
		<script is:inline>
			(function () {
				var t;
				try {
					t = localStorage.getItem('starlight-theme');
				} catch (e) {}
				if (t !== 'light' && t !== 'dark') {
					t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}
				document.documentElement.dataset.theme = t;
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<SiteHeader href={href} repo={repo} />

		<main id="main">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<h1 id="hero-title">OpenClaw, without the browser tab.</h1>
					<p class="lede">
						Pincer is a native Mac and iPhone app for your <a href={openclaw}>OpenClaw</a> Gateway. Send to an agent
						from any app, answer exec approvals from a notification, read your chats offline, and keep every
						gateway in one window.
					</p>
					<div class="cta-row">
						<a class="btn lamp" href={href('getting-started/install/')}>Install Pincer <Icon name="arrow" size={18} /></a>
						<a class="btn" href={href('getting-started/try-the-demo/')}><Icon name="play" size={18} /> Try the demo</a>
						<a class="textlink" href={href('getting-started/why-pincer/')}>Why not just use the Control UI?</a>
					</div>
					<p class="fine">TestFlight beta or build from source, for macOS 15+ and iOS 18+. No gateway yet? The built-in demo runs entirely on your device.</p>
				</div>
				<div class="field">
					<DeviceShot
						mac={heroMac}
						phone={heroPhone}
						macAlt="Pincer on macOS, demo capture with the fictional user Alex: agents in the sidebar and a chat showing thinking, tool cards, a code block and an inline chart."
						phoneAlt="Pincer on iPhone, demo capture: the same kind of transcript on a phone."
						eager
						macSizes="(min-width: 1100px) 640px, (min-width: 900px) 55vw, 100vw"
					/>
				</div>
			</section>

			<div class="lines" id="features">
				<nav class="line-index" aria-label="Feature lines">
					<ol>
						{
							lines.map((l) => (
								<li>
									<a href={`#line-${l.id}`}>
										<span class="socket" aria-hidden="true">
											<span class="lamp-dot" />
										</span>
										<span class="strip">{l.label}</span>
									</a>
								</li>
							))
						}
					</ol>
				</nav>

				{
					lines.map((l) => (
						<section
							class:list={['line', l.flip && 'flip']}
							id={`line-${l.id}`}
							data-line
							aria-labelledby={`h-${l.id}`}
							style={`--cols:${l.cols};${l.pad ? `--pad:${l.pad}` : ''}`}
						>
							<div class="copy">
								<h2 id={`h-${l.id}`}>{l.title}</h2>
								<p class="body">{l.body}</p>
								{l.specifics && (
									<ul class="specifics">
										{l.specifics.map(([b, t]) => (
											<li>
												<strong>{b}</strong> {t}
											</li>
										))}
									</ul>
								)}
								<p class="more">
									{l.links.map(([text, path]) => (
										<a href={href(path)}>{text}</a>
									))}
								</p>
							</div>
							<DeviceShot mac={l.mac} phone={l.phone} macAlt={l.macAlt} phoneAlt={l.phoneAlt} flip={l.flip} />
						</section>
					))
				}
			</div>

			<section class="security" id="security" aria-labelledby="security-title">
				<div class="security-head">
					<h2 id="security-title">A pure client. Nothing more.</h2>
					<div>
						<p>
							Pincer never bundles, launches or embeds a Gateway, and it never registers as a node. It exposes no
							camera, screen, shell or <code>system.run</code> capabilities, so you can use it on machines where the
							official OpenClaw app isn’t allowed.
						</p>
						<a class="textlink" href={href('reference/security/')}>Read the security model</a>
					</div>
				</div>
				<ul class="switches">
					{
						facts.map(([t, d]) => (
							<li>
								<h3>
									<span class="socket" aria-hidden="true">
										<span class="lamp-dot" />
									</span>
									{t}
								</h3>
								<p set:html={d} />
							</li>
						))
					}
				</ul>
			</section>

			<section class="connect" aria-labelledby="connect-title">
				<h2 id="connect-title">Connected in three steps.</h2>
				<ol class="steps">
					<li>
						<span class="num" aria-hidden="true">1</span>
						<h3>Run a Gateway</h3>
						<p>
							Pincer connects to an <a href={openclaw}>OpenClaw</a> Gateway you already run: on this Mac, on your
							LAN, or at home over Tailscale.
						</p>
					</li>
					<li>
						<span class="num" aria-hidden="true">2</span>
						<h3>Add it in Pincer</h3>
						<p>
							Click <strong>+</strong> in the rail, enter the address, and pick token or password auth. Secrets go
							straight to the Keychain.
						</p>
					</li>
					<li>
						<span class="num" aria-hidden="true">3</span>
						<h3>Approve this device</h3>
						<p>On the gateway host, approve the pairing request. Pincer reconnects on its own.</p>
						<pre><code><span class="p">$</span> openclaw devices list
<span class="p">$</span> openclaw devices approve &lt;requestId&gt;</code></pre>
					</li>
				</ol>
				<p class="more">
					<a href={href('getting-started/connect-a-gateway/')}>Connect a gateway</a>
					<a href={href('getting-started/tailscale/')}>Using Tailscale</a>
				</p>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<img src={logo.src} alt="" width="72" height="72" />
				<h2 id="closing-title">Bring your agents home.</h2>
				<p>Free and open source under the MIT license.</p>
				<div class="cta-row">
					<a class="btn lamp" href={href('getting-started/install/')}>Install Pincer <Icon name="arrow" size={18} /></a>
					<a class="btn" href={href('getting-started/try-the-demo/')}><Icon name="play" size={18} /> Try the demo</a>
					<a class="btn" href={repo}><Icon name="github" size={18} /> Star on GitHub</a>
					<a class="textlink" href={href('getting-started/introduction/')}>Read the docs</a>
				</div>
			</section>
		</main>

		<footer class="footer">
			<span class="id">
				<img src={logo.src} alt="" width="22" height="22" />
				Pincer · MIT License
			</span>
			<nav aria-label="Footer">
				<a href={href('getting-started/introduction/')}>Docs</a>
				<a href={href('reference/troubleshooting/')}>Troubleshooting</a>
				<a href={href('development/building/')}>Build from source</a>
				<a href={repo}>GitHub</a>
				<a href={openclaw}>OpenClaw</a>
			</nav>
			<p class="disclaimer">Pincer is an independent client and isn’t affiliated with the OpenClaw project.</p>
		</footer>

		<script>
			const root = document.documentElement;
			const select = document.getElementById('theme-select') as HTMLSelectElement | null;
			const system = matchMedia('(prefers-color-scheme: light)');
			let preference = 'auto';
			try {
				const stored = localStorage.getItem('starlight-theme');
				if (stored === 'light' || stored === 'dark') preference = stored;
			} catch {}
			const apply = () => {
				root.dataset.theme = preference === 'auto' ? (system.matches ? 'light' : 'dark') : preference;
			};
			if (select) {
				select.value = preference;
				select.hidden = false;
				select.addEventListener('change', () => {
					preference = select.value;
					apply();
					try {
						localStorage.setItem('starlight-theme', preference === 'auto' ? '' : preference);
					} catch {}
				});
			}
			system.addEventListener('change', () => { if (preference === 'auto') apply(); });

			const strip = document.querySelector<HTMLElement>('.line-index');
			const links = [...document.querySelectorAll<HTMLAnchorElement>('.line-index a')];
			if (strip) {
				const edge = () =>
					strip.toggleAttribute('data-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4);
				strip.addEventListener('scroll', edge, { passive: true });
				edge();
			}
			if (strip && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							for (const a of links) {
								const on = a.hash === `#${e.target.id}`;
								a.toggleAttribute('data-lit', on);
								if (on) strip.scrollLeft = a.offsetLeft - (strip.clientWidth - a.offsetWidth) / 2;
							}
						}
					},
					{ rootMargin: '-45% 0px -50% 0px' },
				);
				document.querySelectorAll('[data-line]').forEach((s) => io.observe(s));
			}
		</script>
	</body>
</html>
