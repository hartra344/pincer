---
import Icon from '../components/Icon.astro';
import DeviceShot from '../components/landing/DeviceShot.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import '../styles/tokens.css';
import '../components/landing/landing.css';
import logo from '../assets/logo.svg';
import heroMac from '../assets/screenshots/features/homepage.png';
import heroPhone from '../assets/screenshots/ios/transcript.png';
import transcriptMac from '../assets/screenshots/transcript.png';
import transcriptPhone from '../assets/screenshots/ios/tool-details.png';
import channelsMac from '../assets/screenshots/organize-chats.png';
import channelsPhone from '../assets/screenshots/ios/organize-chats.png';
import approvalsMac from '../assets/screenshots/exec-approval.png';
import approvalsPhone from '../assets/screenshots/ios/exec-approval.png';
import runsMac from '../assets/screenshots/features/run-tree.png';
import runsPhone from '../assets/screenshots/features/ios/run-tree.png';
import gatewayMac from '../assets/screenshots/gateway-settings.png';
import gatewayPhone from '../assets/screenshots/ios/gateway-settings.png';
import commandsMac from '../assets/screenshots/slash-commands.png';
import commandsPhone from '../assets/screenshots/ios/slash-commands.png';
import themesMac from '../assets/screenshots/appearance.png';
import themesPhone from '../assets/screenshots/ios/appearance.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const repo = 'https://github.com/hartra344/pincer';
const openclaw = 'https://github.com/openclaw/openclaw';

const themes = [
	{ name: 'Default', colors: ['#0a84ff', '#34c759', '#ff9f0a'] },
	{ name: 'Lobster', colors: ['#E8543D', '#2F7FD8', '#1E1614'] },
	{ name: 'Ocean', colors: ['#0A84C6', '#13A5A5', '#0F1A22'] },
	{ name: 'Forest', colors: ['#2E8B57', '#8A6D3B', '#121A14'] },
	{ name: 'Grape', colors: ['#8E44AD', '#C0399B', '#19131E'] },
	{ name: 'Sunset', colors: ['#E67E22', '#E74C3C', '#1F1712'] },
	{ name: 'Graphite', colors: ['#5E6670', '#4B5563', '#161718'] },
	{ name: 'Midnight', colors: ['#4F6BED', '#7C4DFF', '#0B0E1A'] },
];

const lines = [
	{
		id: 'transcript',
		label: 'Transcript',
		title: 'See the work, not just the answer.',
		body: 'Native table views, not a web view. Every chat is cached in the background, so scrolling up never waits on the network.',
		specifics: [
			['Live thinking', 'streams in a collapsible section. Show it never, live only, or for every turn.'],
			['Tool calls', 'are cards with their arguments and result.'],
			['Inline images', 'and MEDIA: lines render inline, with a Quick Look-style preview and sharing.'],
			['Your messages', 'show up under your name, even when sent from another app, with a small tag for where.'],
		],
		links: [['Read the transcript guide', 'guides/transcript/']],
		mac: transcriptMac,
		phone: transcriptPhone,
		macAlt: 'Pincer on macOS, demo capture: a transcript with a thinking section and tool-call cards.',
		phoneAlt: 'Pincer on iPhone, demo capture: the details of a tool call.',
		cols: 'minmax(0, 5fr) minmax(0, 7fr)',
	},
	{
		id: 'channels',
		label: 'Channels',
		title: 'Organized by channel.',
		body: 'Servers, #channels, automations and agents, each in their own section. Or group by agent, by group, or by recency.',
		links: [['Read the guide to organizing chats', 'guides/organizing-chats/']],
		mac: channelsMac,
		phone: channelsPhone,
		macAlt: 'Pincer on macOS, demo capture: the sidebar with chats grouped by agent, channel and server.',
		phoneAlt: 'Pincer on iPhone, demo capture: the chat list grouped into sections.',
		flip: true,
		cols: 'minmax(0, 6fr) minmax(0, 6fr)',
		pad: 'var(--space-8)',
	},
	{
		id: 'approvals',
		label: 'Approvals',
		title: 'Approve without opening the app.',
		body: 'Allow once, always allow or deny an exec request from a banner or right from the notification. Reply without opening the app.',
		links: [['Read the approvals guide', 'guides/approvals-and-notifications/']],
		mac: approvalsMac,
		phone: approvalsPhone,
		macAlt: 'Pincer on macOS, demo capture: an exec approval request with allow once, always allow and deny.',
		phoneAlt: 'Pincer on iPhone, demo capture: the same exec approval request.',
		cols: 'minmax(0, 4fr) minmax(0, 8fr)',
		pad: 'var(--space-9)',
	},
	{
		id: 'runs',
		label: 'Runs',
		title: 'Follow every subagent run.',
		body: 'Subagent runs open straight from the tool call that started them, so you can see what each agent is doing and what it spawned.',
		links: [['Read the subagents and runs guide', 'guides/subagents-and-runs/']],
		mac: runsMac,
		phone: runsPhone,
		macAlt: 'Pincer on macOS, demo capture: a tree of subagent runs.',
		phoneAlt: 'Pincer on iPhone, demo capture: the run tree.',
		flip: true,
		cols: 'minmax(0, 5fr) minmax(0, 7fr)',
	},
	{
		id: 'gateway',
		label: 'Gateway',
		title: 'Manage the gateway itself.',
		body: 'Curated pages built from your gateway’s schema, plugin management, and a shared draft with an unsaved-changes review.',
		specifics: [
			['Health, logs and usage', 'sit next to your chats.'],
			['Agents, devices and skills', 'are managed from the same window.'],
		],
		links: [['Read the Gateway Settings guide', 'guides/gateway-settings/']],
		mac: gatewayMac,
		phone: gatewayPhone,
		macAlt: 'Pincer on macOS, demo capture: Gateway Settings.',
		phoneAlt: 'Pincer on iPhone, demo capture: Gateway Settings.',
		cols: 'minmax(0, 5fr) minmax(0, 7fr)',
	},
	{
		id: 'commands',
		label: 'Commands',
		title: 'Type / for everything.',
		body: 'See the commands your gateway offers, including skills, plugins, models and thinking levels, with argument completion.',
		links: [
			['Read the composer guide', 'guides/composer/'],
			['Command palette and navigation', 'guides/command-palette-and-navigation/'],
		],
		mac: commandsMac,
		phone: commandsPhone,
		macAlt: 'Pincer on macOS, demo capture: the composer with slash-command suggestions.',
		phoneAlt: 'Pincer on iPhone, demo capture: slash-command suggestions.',
		flip: true,
		cols: 'minmax(0, 6fr) minmax(0, 6fr)',
		pad: 'var(--space-8)',
	},
	{
		id: 'themes',
		label: 'Themes',
		title: 'Eight themes, light and dark.',
		body: 'Eight built-in themes with light and dark shades. Override any color, and give chats and groups their own icons and colors.',
		links: [['Read the appearance guide', 'guides/appearance/']],
		mac: themesMac,
		phone: themesPhone,
		macAlt: 'Pincer on macOS, demo capture: the Appearance settings with theme choices.',
		phoneAlt: 'Pincer on iPhone, demo capture: the Appearance settings.',
		cols: 'minmax(0, 6fr) minmax(0, 6fr)',
		themes: true,
	},
];

const facts = [
	['Per-device identity', 'An Ed25519 key in the Keychain, this device only. The gateway approves it once.'],
	['Encrypted transport', '<code>wss://</code> required off your LAN or tailnet, with optional TLS certificate pinning.'],
	['Scoped access', 'Read, write and approvals by default. Admin only when you ask for it.'],
	['Sandboxed', 'The macOS app is sandboxed and caches transcripts with complete file protection.'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Pincer: a native macOS and iOS client for OpenClaw</title>
		<meta
			name="description"
			content="Pincer is a native macOS and iOS client for OpenClaw. Channel-style chat organization with live thinking, tool calls, inline images and exec approvals."
		/>
		<meta name="theme-color" content="#17211e" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#e6ece8" media="(prefers-color-scheme: light)" />
		<link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
		<meta property="og:title" content="Pincer for OpenClaw" />
		<meta
			property="og:description"
			content="Your OpenClaw agents in a native Mac and iPhone app, with thinking, tool calls and inline images."
		/>
		<meta property="og:type" content="website" />
		<script is:inline>
			(function () {
				var t;
				try {
					t = localStorage.getItem('starlight-theme');
				} catch (e) {}
				if (t !== 'light' && t !== 'dark') {
					t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}
				document.documentElement.dataset.theme = t;
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<SiteHeader href={href} repo={repo} />

		<main id="main">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<h1 id="hero-title">Your agents, in a native chat app.</h1>
					<p class="lede">
						Pincer keeps what works about chatting with your <a href={openclaw}>OpenClaw</a> agents in a messaging
						app, like organized channels and notifications, and adds what a plain chat window can’t show: thinking,
						tool calls, inline images, and messages that are clearly yours.
					</p>
					<div class="cta-row">
						<a class="btn lamp" href={href('getting-started/install/')}>Install Pincer <Icon name="arrow" size={18} /></a>
						<a class="btn" href={href('getting-started/try-the-demo/')}><Icon name="play" size={18} /> Try the demo</a>
						<a class="textlink" href={href('getting-started/introduction/')}>Read the docs</a>
					</div>
					<p class="fine">TestFlight beta or build from source, for macOS 15+ and iOS 18+. No gateway yet? The built-in demo runs entirely on your device.</p>
				</div>
				<div class="field">
					<DeviceShot
						mac={heroMac}
						phone={heroPhone}
						macAlt="Pincer on macOS, demo capture with the fictional user Alex: agents in the sidebar and a chat showing thinking, tool cards, a code block and an inline chart."
						phoneAlt="Pincer on iPhone, demo capture: the same kind of transcript on a phone."
						eager
						macSizes="(min-width: 1100px) 640px, (min-width: 900px) 55vw, 100vw"
					/>
				</div>
			</section>

			<div class="lines" id="features">
				<nav class="line-index" aria-label="Feature lines">
					<ol>
						{
							lines.map((l) => (
								<li>
									<a href={`#line-${l.id}`}>
										<span class="socket" aria-hidden="true">
											<span class="lamp-dot" />
										</span>
										<span class="strip">{l.label}</span>
									</a>
								</li>
							))
						}
					</ol>
				</nav>

				{
					lines.map((l) => (
						<section
							class:list={['line', l.flip && 'flip']}
							id={`line-${l.id}`}
							data-line
							aria-labelledby={`h-${l.id}`}
							style={`--cols:${l.cols};${l.pad ? `--pad:${l.pad}` : ''}`}
						>
							<div class="copy">
								<h2 id={`h-${l.id}`}>{l.title}</h2>
								<p class="body">{l.body}</p>
								{l.specifics && (
									<ul class="specifics">
										{l.specifics.map(([b, t]) => (
											<li>
												<strong>{b}</strong> {t}
											</li>
										))}
									</ul>
								)}
								{l.themes && (
									<ul class="plates" aria-label="Built-in themes">
										{themes.map((t) => (
											<li class="plate">
												<span class="chips" aria-hidden="true">
													{t.colors.map((c) => (
														<i style={`background:${c}`} />
													))}
												</span>
												{t.name}
											</li>
										))}
									</ul>
								)}
								<p class="more">
									{l.links.map(([text, path]) => (
										<a href={href(path)}>{text}</a>
									))}
								</p>
							</div>
							<DeviceShot mac={l.mac} phone={l.phone} macAlt={l.macAlt} phoneAlt={l.phoneAlt} flip={l.flip} />
						</section>
					))
				}
			</div>

			<section class="security" id="security" aria-labelledby="security-title">
				<div class="security-head">
					<h2 id="security-title">A pure client. Nothing more.</h2>
					<div>
						<p>
							Pincer never bundles, launches or embeds a Gateway, and it never registers as a node. It exposes no
							camera, screen, shell or <code>system.run</code> capabilities, so you can use it on machines where the
							official OpenClaw app isn’t allowed.
						</p>
						<a class="textlink" href={href('reference/security/')}>Read the security model</a>
					</div>
				</div>
				<ul class="switches">
					{
						facts.map(([t, d]) => (
							<li>
								<h3>
									<span class="socket" aria-hidden="true">
										<span class="lamp-dot" />
									</span>
									{t}
								</h3>
								<p set:html={d} />
							</li>
						))
					}
				</ul>
			</section>

			<section class="connect" aria-labelledby="connect-title">
				<h2 id="connect-title">Connected in three steps.</h2>
				<ol class="steps">
					<li>
						<span class="num" aria-hidden="true">1</span>
						<h3>Run a Gateway</h3>
						<p>
							Pincer connects to an <a href={openclaw}>OpenClaw</a> Gateway you already run: on this Mac, on your
							LAN, or at home over Tailscale.
						</p>
					</li>
					<li>
						<span class="num" aria-hidden="true">2</span>
						<h3>Add it in Pincer</h3>
						<p>
							Click <strong>+</strong> in the rail, enter the address, and pick token or password auth. Secrets go
							straight to the Keychain.
						</p>
					</li>
					<li>
						<span class="num" aria-hidden="true">3</span>
						<h3>Approve this device</h3>
						<p>On the gateway host, approve the pairing request. Pincer reconnects on its own.</p>
						<pre><code><span class="p">$</span> openclaw devices list
<span class="p">$</span> openclaw devices approve &lt;requestId&gt;</code></pre>
					</li>
				</ol>
				<p class="more">
					<a href={href('getting-started/connect-a-gateway/')}>Connect a gateway</a>
					<a href={href('getting-started/tailscale/')}>Using Tailscale</a>
				</p>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<img src={logo.src} alt="" width="72" height="72" />
				<h2 id="closing-title">Bring your agents home.</h2>
				<p>Free and open source under the MIT license.</p>
				<div class="cta-row">
					<a class="btn lamp" href={href('getting-started/install/')}>Install Pincer <Icon name="arrow" size={18} /></a>
					<a class="btn" href={href('getting-started/try-the-demo/')}><Icon name="play" size={18} /> Try the demo</a>
					<a class="btn" href={repo}><Icon name="github" size={18} /> Star on GitHub</a>
					<a class="textlink" href={href('getting-started/introduction/')}>Read the docs</a>
				</div>
			</section>
		</main>

		<footer class="footer">
			<span class="id">
				<img src={logo.src} alt="" width="22" height="22" />
				Pincer · MIT License
			</span>
			<nav aria-label="Footer">
				<a href={href('getting-started/introduction/')}>Docs</a>
				<a href={href('reference/troubleshooting/')}>Troubleshooting</a>
				<a href={href('development/building/')}>Build from source</a>
				<a href={repo}>GitHub</a>
				<a href={openclaw}>OpenClaw</a>
			</nav>
			<p class="disclaimer">Pincer is an independent client and isn’t affiliated with the OpenClaw project.</p>
		</footer>

		<script>
			const root = document.documentElement;
			const toggle = document.getElementById('theme-toggle');
			const sync = () => {
				const light = root.dataset.theme === 'light';
				toggle?.setAttribute('aria-label', `Switch to ${light ? 'dark' : 'light'} theme`);
			};
			if (toggle) {
				toggle.hidden = false;
				sync();
				toggle.addEventListener('click', () => {
					const next = root.dataset.theme === 'light' ? 'dark' : 'light';
					root.dataset.theme = next;
					try {
						localStorage.setItem('starlight-theme', next);
					} catch {}
					sync();
				});
			}

			const strip = document.querySelector<HTMLElement>('.line-index');
			const links = [...document.querySelectorAll<HTMLAnchorElement>('.line-index a')];
			if (strip) {
				const edge = () =>
					strip.toggleAttribute('data-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4);
				strip.addEventListener('scroll', edge, { passive: true });
				edge();
			}
			if (strip && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							for (const a of links) {
								const on = a.hash === `#${e.target.id}`;
								a.toggleAttribute('data-lit', on);
								if (on) strip.scrollLeft = a.offsetLeft - (strip.clientWidth - a.offsetWidth) / 2;
							}
						}
					},
					{ rootMargin: '-45% 0px -50% 0px' },
				);
				document.querySelectorAll('[data-line]').forEach((s) => io.observe(s));
			}
		</script>
	</body>
</html>
