# Copy to .env (next to server.mjs). Real environment variables override these.

# At least 32 random characters. `./install-service.sh` fills this in if it's empty.
# Changing it later just makes devices re-register on their next connect.
RELAY_SECRET=

# From developer.apple.com → Keys: the APNs key's Key ID, and your Team ID (Membership).
APNS_KEY_ID=
APNS_TEAM_ID=

# The downloaded AuthKey_<KEYID>.p8. A relative path is relative to this folder.
APNS_KEY_FILE=AuthKey.p8

# Bundle ids allowed to register (comma-separated).
APNS_TOPICS=chat.pincer.ios

# Listen address. Keep it on loopback and put HTTPS in front (tailscale serve).
HOST=127.0.0.1
PORT=8787
