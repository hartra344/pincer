<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reads the per-gateway Web Push keys the app stores in the shared Keychain group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)chat.pincer.shared</string>
	</array>
</dict>
</plist>
